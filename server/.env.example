# Copy to .env (or export these) — see docs/DESIGN.md §6.
# Generate the encryption key:  openssl rand -base64 32
WIFI_JWT_SECRET=change-me
WIFI_ENCRYPTION_KEY=

# Transactional SMTP (verification / password-reset email; dev compose
# overrides these to point at MailHog)
WIFI_SMTP_HOST=smtp.example.com
WIFI_SMTP_PORT=587
WIFI_SMTP_USER=login@example.com
WIFI_SMTP_PASSWORD=secret
WIFI_SMTP_FROM=no-reply@example.com
